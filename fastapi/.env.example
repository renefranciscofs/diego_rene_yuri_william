JWT_SECRET_KEY=changeme
JWT_EXPIRE_MINUTES=30

# CORS: origens autorizadas a consumir a API via browser, separadas por
# vírgula. Nunca usar "*" em produção. Ex.: para desenvolvimento local
# de um frontend em http://localhost:3000:
ALLOWED_ORIGINS=http://localhost:3000

# Rate limiting de POST /auth/token (ver security/rate_limit.py para a
# justificativa da escolha destes valores).
AUTH_RATE_LIMIT_MAX_ATTEMPTS=5
AUTH_RATE_LIMIT_WINDOW_SECONDS=60
